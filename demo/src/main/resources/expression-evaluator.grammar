-- Mathematical Expression Evaluator Grammar
-- Supports advanced mathematical operations and functions
-- Includes trigonometric functions, logarithms, and constants

-- Numbers and identifiers
NUMBER = {[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?}
IDENTIFIER = {[a-zA-Z][a-zA-Z0-9]*}

-- Operators (in precedence order)
POWER = {\^}
MULTIPLY = {\*}
DIVIDE = {/}
MODULO = {%}
PLUS = {\+}
MINUS = {\-}

-- Punctuation
LPAREN = {\(}
RPAREN = {\)}
COMMA = {,}

-- Mathematical constants (treated as special identifiers)
PI = {pi}
E = {e}

-- Function names
SIN = {sin}
COS = {cos}
TAN = {tan}
LOG = {log}
LN = {ln}
SQRT = {sqrt}
ABS = {abs}

Start = <Expression>

-- Expression with addition and subtraction (lowest precedence)
<Expression> ::= <Term> PLUS <Expression> | <Term> MINUS <Expression> | <Term>

-- Term with multiplication, division, and modulo
<Term> ::= <Factor> MULTIPLY <Term> | <Factor> DIVIDE <Term> | <Factor> MODULO <Term> | <Factor>

-- Factor with exponentiation (right associative)
<Factor> ::= <Base> POWER <Factor> | <Base>

-- Base expressions: numbers, variables, functions, parentheses
<Base> ::= NUMBER | IDENTIFIER | PI | E | <UnaryFunction> LPAREN <Expression> RPAREN | <BinaryFunction> LPAREN <Expression> COMMA <Expression> RPAREN | LPAREN <Expression> RPAREN | MINUS <Base>

-- Functions that take one argument
<UnaryFunction> ::= SIN | COS | TAN | LN | SQRT | ABS

-- Functions that take two arguments
<BinaryFunction> ::= LOG